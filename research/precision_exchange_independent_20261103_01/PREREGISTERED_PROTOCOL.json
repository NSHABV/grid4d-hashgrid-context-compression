  "scope": "One original full FP32 xyz min/max shared by all levels/channels and all precision; no fitted clipping",
  "arithmetic": "FP64 step=(b-a)/(2**p-1); np.rint((x-a)/step), nearest-even; clip before cast; clip(a+float64(q)*step,a,b).astype(float32); constants step0,codes0; nonfinite INPUT_BLOCKED",
  "storage": "grid4d-spatial-exchange-v5; same canonical ZIP/NPY1.0 DEFLATE6; uint8 for7/8,little-endian uint16 for10; 16 levels,per-level precision map, sharedrange; no bitpacking",
  "budget": "actual filesystem bytes G8 in common format; candidate<=B_max strict no tolerance",
  "selection": "D_best fromG8+D; E_best fromG8+E; strict valSSIM>=G8 and valLPIPS<=G8; maximize mean per-view valPSNR, ties fewerbytes,fewerchangedlevels,lexicographicindices. FINAL_choice same ordering amongG8,D_best,E_best. G8 fallback",
  "quality": "All official val/test; same 800x800 black PNG roundtrip FP32 mean per-view PSNR, SSIM, LPIPS_STANDARD_VGG normalize=True once, fixed_attention; no test scores before selection freeze",
  "reuse": "No standup quality reuse presumed; every new state directly evaluated from independent decoder output",
  "freeze": "Complete validation and any matched-donor diagnostic before selection freeze. Test only R0,G8,D_best,E_best,D_matched unique; no reselection",
  "correctness": "Exact codes,dtype,endian,offsets,metadata,canonicalFP32,unchanged levels,allallocatedrows,byte-identicalrebuild; reuse unchanged p7/p8/p10 scalar tests and at most one read-only prior-result regression",
  "guards": {
    "min_available_RAM_B": 1073741824,
    "min_start_available_RAM_B": 2147483648,
    "max_device_used_MiB": 7168,
    "min_start_GPU_free_MiB": 3072,
    "min_disk_free_B": 8589934592,
    "max_job_seconds": 1800
  },
  "retention": "50 full exchange-v5 archives, sequential temporary reconstruction/model; preserve all previous artifacts",
  "limits": "One standup scene, one full seed0 training; no new levels/precisions/ranges/compressors/multidonors/recipients/H5; no test retuning",
  "hashing": "dependencies before execution; one final full protected-artifact check; no full oldaudit per pair",
  "checkpoint_selection": "Use provenance-verified compatible completed iteration50000, else one fresh seed0 official-config 50000-step training; no quality-based selection",
  "independence": "Audit project and WSL inventory before results; configs/catalog-only mentions do not imply method development; if uncertain stop INDEPENDENCE_BLOCKED; never replace scene",
  "splits": "All official train/val/test observations. Stop SPLIT_BLOCKED on any val/train or val/test shared normalized path, identical image or full (extrinsics,intrinsics,time) observation. Never filter/repartition. Same time alone is not identity.",
